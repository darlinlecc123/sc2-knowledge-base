{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storm-sc2kb.local/schemas/variable.schema.json",
  "title": "STORM PySC2 Raw API Variable Record",
  "description": "第一版 STORM 变量知识库中单个变量记录的统一结构。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "canonical_name",
    "names",
    "category",
    "aliases",
    "definition",
    "intuitive_explanation",
    "interface",
    "provenance",
    "implementation",
    "consumers",
    "lifecycle",
    "examples",
    "relationships",
    "design_intent",
    "code_reality",
    "limitations",
    "known_issues",
    "evidence",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "description": "跨文件稳定、可机器引用的变量 ID。"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en",
        "code"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "category": {
      "enum": [
        "environment_config",
        "timestep_player_score",
        "raw_unit",
        "tbox_static",
        "abox_dynamic",
        "derived_tactical_state",
        "action_schema_and_scheduling",
        "pysc2_function_call",
        "swm",
        "experiment_metric",
        "heuristic_and_rl_baselines",
        "unknown_ontology_extension"
      ]
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "intuitive_explanation": {
      "type": "string",
      "minLength": 1
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_type",
        "python_type",
        "shape",
        "unit",
        "dimension",
        "range",
        "enum_values",
        "nullable",
        "pysc2_path",
        "storm_paths"
      ],
      "properties": {
        "data_type": {
          "enum": [
            "integer",
            "number",
            "string",
            "boolean",
            "object",
            "array"
          ]
        },
        "python_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "shape": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dimensions",
            "description"
          ],
          "properties": {
            "kind": {
              "enum": [
                "scalar",
                "vector",
                "matrix",
                "table",
                "graph",
                "object",
                "sequence",
                "unknown"
              ]
            },
            "dimensions": {
              "type": "array",
              "items": {
                "type": [
                  "integer",
                  "string"
                ]
              }
            },
            "description": {
              "type": "string"
            }
          }
        },
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status",
            "note"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "known",
                "not_applicable",
                "unknown",
                "needs_verification"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "dimension": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status",
            "note"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "known",
                "not_applicable",
                "unknown",
                "needs_verification"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "minimum",
            "maximum",
            "minimum_inclusive",
            "maximum_inclusive",
            "description"
          ],
          "properties": {
            "status": {
              "enum": [
                "known",
                "not_applicable",
                "unknown",
                "needs_verification"
              ]
            },
            "minimum": {
              "type": [
                "number",
                "null"
              ]
            },
            "maximum": {
              "type": [
                "number",
                "null"
              ]
            },
            "minimum_inclusive": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "maximum_inclusive": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "description": {
              "type": "string"
            }
          }
        },
        "enum_values": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "values",
            "description"
          ],
          "properties": {
            "status": {
              "enum": [
                "known",
                "not_applicable",
                "unknown",
                "needs_verification"
              ]
            },
            "values": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": [
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              }
            },
            "description": {
              "type": "string"
            }
          }
        },
        "nullable": {
          "type": "boolean"
        },
        "pysc2_path": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "status",
            "note"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "enum": [
                "known",
                "not_applicable",
                "unknown",
                "needs_verification"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "storm_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_layer",
        "derivation_kind",
        "upstream_variable_ids"
      ],
      "properties": {
        "source_layer": {
          "enum": [
            "environment_config",
            "pysc2_timestep",
            "pysc2_raw_observation",
            "raw_unit_transformed",
            "tbox_static",
            "abox_runtime",
            "derived_runtime",
            "llm_output",
            "validated_action",
            "executor_mapping",
            "swm_prediction",
            "experiment_aggregate"
          ]
        },
        "derivation_kind": {
          "enum": [
            "direct_read",
            "static_declaration",
            "renamed",
            "normalized",
            "computed",
            "validated",
            "scheduled",
            "aggregated",
            "predicted"
          ]
        },
        "upstream_variable_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_locations",
        "extraction_code",
        "transformation_formula"
      ],
      "properties": {
        "source_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceLocation"
          }
        },
        "extraction_code": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "transformation_formula": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "path",
          "symbol",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "update_timing",
        "scope",
        "persistence"
      ],
      "properties": {
        "update_timing": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "static_repository",
            "per_observation",
            "per_agent_step",
            "per_decision",
            "per_action",
            "per_episode",
            "per_experiment"
          ]
        },
        "persistence": {
          "type": "string"
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario",
          "input",
          "output",
          "explanation"
        ],
        "properties": {
          "scenario": {
            "type": "string"
          },
          "input": {},
          "output": {},
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "target_id",
          "description"
        ],
        "properties": {
          "relation": {
            "enum": [
              "derived_from",
              "transformed_to",
              "consumed_by",
              "constrains",
              "distinct_from",
              "related_to"
            ]
          },
          "target_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "design_intent": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "code_reality": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "status",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "needs_verification",
              "not_applicable"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verified_at",
        "sc2_executed",
        "tests_executed",
        "external_sources_checked",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "static_verified",
            "runtime_verified",
            "partially_verified",
            "needs_verification"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "sc2_executed": {
          "type": "boolean"
        },
        "tests_executed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "result"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "passed",
                  "failed",
                  "not_executed"
                ]
              }
            }
          }
        },
        "external_sources_checked": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "symbol",
        "line_start",
        "line_end"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "status",
        "evidence_ids"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "code_reality",
            "runtime_observation",
            "design_intent",
            "derived_runtime",
            "needs_verification"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "symbol",
        "line_start",
        "line_end",
        "evidence_type",
        "claim",
        "fact_status",
        "verified_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "evidence_type": {
          "enum": [
            "E1",
            "E2",
            "E3",
            "E4",
            "E5",
            "E6"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "fact_status": {
          "enum": [
            "code_reality",
            "runtime_observation",
            "design_intent",
            "derived_runtime",
            "needs_verification"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
